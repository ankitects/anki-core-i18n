studying-card-studied-in-minute =
    { $cards ->
        [one]
            { $minutes ->
                [one]
                    { $cards } kort pugget på
                    ett minutt.
               *[other]
                    { $cards } kort pugget på
                    { $minutes } minutter.
            }
       *[other]
            { $minutes ->
                [one]
                    { $cards } kort pugget på
                    ett minutt.
               *[other]
                    { $cards } kort pugget på
                    { $minutes } minutter.
            }
    }

